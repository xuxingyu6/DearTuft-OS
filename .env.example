# Copy to .env.local. Leave both empty to use the local JSON fallback
# (data/local-db.json) and the three demo accounts on the login page.
# On Vercel, missing values show a setup message instead of the local file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Signs the local-mode session cookie. Not used once Supabase is configured.
# LOCAL_SESSION_SECRET=
